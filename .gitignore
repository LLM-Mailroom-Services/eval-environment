# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Eval case dirs are local; reports/ stays tracked (experiment log, calibration,
# API-leg comparison writeups). Root-anchored so web/data/ is not caught.
/data/*
hf_cache/
*.db
*.db-wal
*.db-shm

# Deliverables tracked despite the data ignore:
# - reports/ (entire tree — do not gitignore)
# - data/manifests/subset-draws/ = canonical comparison subset draws (#20)
!/data/manifests/
!/data/manifests/subset-draws/

# The Vercel viewer snapshot IS tracked (generated by scripts/export_site_snapshot.py)
!web/data/snapshot.json

# Local pipeline checkouts (path sources / bootstrap targets; never commit)
Digital-Mailroom/

# Env & secrets
.env
*.key

# OS / editor
.DS_Store
.idea/
.vscode/
docs/.Rhistory
/.cursor/agents
