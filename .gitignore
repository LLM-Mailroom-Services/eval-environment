# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Eval artifacts (append-only logs are regenerable; run dirs are local)
# (root-anchored so the tracked web/data/ viewer snapshot is not caught)
/data/*
/reports/*
hf_cache/
*.db
*.db-wal
*.db-shm

# Deliverables tracked despite the root ignores:
# - reports/api-comparisons/ = Modal-comparable API-leg run reports (paired
#   with the sandbox Modal reports, filed by model)
# - data/manifests/subset-draws/ = canonical comparison subset draws (#20)
!/reports/api-comparisons/
!/data/manifests/
!/data/manifests/subset-draws/

# The Vercel viewer snapshot IS tracked (generated by scripts/export_site_snapshot.py)
!web/data/snapshot.json

# Local pipeline checkouts (path sources / bootstrap targets; never commit)
Digital-Mailroom/

# Env & secrets
.env
*.key

# OS / editor
.DS_Store
.idea/
.vscode/
docs/.Rhistory
/.cursor/agents
