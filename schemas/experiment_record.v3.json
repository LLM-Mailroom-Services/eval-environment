{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mailroom-evals experiment record (v3)",
  "oneOf": [
    { "$ref": "#/$defs/run_summary" },
    { "$ref": "#/$defs/case" }
  ],
  "$defs": {
    "run_summary": {
      "type": "object",
      "required": ["schema_version", "record_kind", "run_id", "family", "task", "mode", "started_at", "finished_at", "dataset", "metrics"],
      "properties": {
        "schema_version": { "enum": [1, 2, 3] },
        "record_kind": { "const": "run_summary" },
        "run_id": { "type": "string" },
        "family": { "enum": ["eval", "pilot", "calibration"] },
        "task": { "type": "string" },
        "invoke": { "enum": ["node", "agent", null] },
        "mode": { "enum": ["mock", "real"] },
        "model": { "type": ["string", "null"] },
        "prompt_version": { "type": ["string", "null"] },
        "prompt_lineage": { "enum": ["frozen", "mutation", "live-docclass", "production", null] },
        "prompt_source": { "enum": ["frozen", "live-docclass", "production", null] },
        "prompt_versions": { "type": ["object", "null"] },
        "pipeline_git": { "type": ["string", "null"] },
        "prompts_snapshot_path": { "type": ["string", "null"] },
        "trace_backend": { "enum": ["braintrust", "phoenix", "none", null] },
        "trace_ids": { "type": ["object", "null"] },
        "dataset": {
          "type": "object",
          "properties": {
            "repo": { "type": "string" },
            "config": { "type": ["string", "null"] },
            "split": { "type": ["string", "null"] },
            "revision": { "type": ["string", "null"] },
            "subset": { "type": ["string", "null"] },
            "n_selected": { "type": "integer" },
            "n_total": { "type": "integer" },
            "seed": { "type": ["integer", "null"] },
            "case_ids": { "type": "array", "items": { "type": "string" } },
            "filenames": { "type": "array", "items": { "type": ["string", "null"] } },
            "subset_manifest_path": { "type": ["string", "null"] },
            "subset_manifest_jsonl": { "type": ["string", "null"] }
          }
        },
        "git": {
          "type": "object",
          "properties": {
            "commit": { "type": ["string", "null"] },
            "dirty": { "type": ["boolean", "null"] }
          }
        },
        "started_at": { "type": "string" },
        "finished_at": { "type": "string" },
        "duration_s": { "type": ["number", "null"] },
        "params": { "type": "object" },
        "metrics": { "type": "object" },
        "performance": { "type": "object" },
        "calibration": { "type": ["object", "null"] },
        "judging": {
          "type": ["object", "null"],
          "description": "v2: post-hoc local judge results appended as a follow-up record",
          "properties": {
            "dimensions": { "type": "array" },
            "judge_model": { "type": ["string", "null"] },
            "prompt_versions": { "type": "object" },
            "mock": { "type": "boolean" },
            "metrics": { "type": "object" },
            "judgments_ref": { "type": "string" }
          }
        },
        "preflight": {
          "type": ["object", "null"],
          "description": "v3: preflight report (ok, mode, task_id, checks, issues, framing, resolved)",
          "properties": {
            "ok": { "type": "boolean" },
            "mode": { "enum": ["mock", "real"] },
            "task_id": { "type": "string" },
            "checks": { "type": "array" },
            "issues": { "type": "array" },
            "framing": { "type": ["object", "null"] },
            "resolved": { "type": "object" }
          }
        },
        "task_framing": {
          "type": ["object", "null"],
          "description": "v3: the eval-task contract framing (node, request, agent_roles, prompt_role, entity_fields, output_keys)"
        },
        "scoring_suite": {
          "type": ["object", "null"],
          "description": "v3: pointer + rollup for the full deterministic scoring suite artifact (metrics_full, metrics_essential, performance, post_hoc commands)",
          "properties": {
            "path": { "type": "string" },
            "scorer": { "type": "string" },
            "n_cases": { "type": "integer" },
            "n_errors": { "type": "integer" }
          }
        },
        "flush": {
          "type": ["object", "null"],
          "description": "v3: affirmative trace-sink flush counters (dropped-event evidence)"
        },
        "cases_ref": { "type": ["string", "null"] },
        "cases_embedded": { "type": "array" },
        "error": { "type": ["string", "null"] }
      }
    },
    "case": {
      "type": "object",
      "required": ["schema_version", "record_kind", "run_id", "case_id"],
      "properties": {
        "schema_version": { "enum": [1, 2, 3] },
        "record_kind": { "const": "case" },
        "run_id": { "type": "string" },
        "case_id": { "type": "string" },
        "filename": { "type": ["string", "null"] },
        "expected_doc_class": { "type": ["string", "null"] },
        "expected_subclass": { "type": ["string", "null"] },
        "doc_text_sha256": { "type": ["string", "null"] },
        "prediction": { "type": ["object", "null"] },
        "scores": { "type": "object" },
        "latency_ms": { "type": ["number", "null"] },
        "tokens": { "type": ["object", "null"] },
        "cost_usd": { "type": ["number", "null"] },
        "agent_usage": {
          "type": ["object", "null"],
          "description": "v3: per-agent usage attribution (calls/tokens/models per agent) — non-negotiable #9, previously undeclared"
        },
        "trace": { "type": ["object", "null"] },
        "error": { "type": ["string", "null"] }
      }
    }
  }
}
